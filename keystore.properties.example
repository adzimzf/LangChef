# Alternatively set LANGCHEF_KEYSTORE_FILE, LANGCHEF_KEYSTORE_PASSWORD,
# LANGCHEF_KEY_ALIAS and LANGCHEF_KEY_PASSWORD in the environment.
storeFile=langchef-release.keystore
